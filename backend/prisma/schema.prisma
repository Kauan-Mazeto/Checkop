// Modelo do Banco a seguir: Projeto Checkop

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  DEV
  QA
  PENTESTER
  STUDENT
}

enum TargetEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  FALSE_POSITIVE
  FIXED
  IGNORED
}

enum ToolType {
  ZAP
  NUCLEI
}

model User {
  id                       String    @id @default(uuid())
  name                     String
  email                    String    @unique
  password                 String?
  role                     Role      @default(DEV)
  googleId                 String?   @unique
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  resetPasswordRequestedAt DateTime?
  resetPasswordAttempts    Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  scans                    Scan[]
}

model Scan {
  id          String            @id @default(uuid())
  targetUrl   String
  environment TargetEnvironment @default(DEVELOPMENT)
  safeMode    Boolean           @default(true)
  status      ScanStatus        @default(PENDING)
  resolvedIp  String?
  suspiciousEnvironment         Boolean           @default(false)
  authorizationConfirmedAt      DateTime
  authorizationIp               String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime          @default(now())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@index([suspiciousEnvironment])
}

model Finding {
  id          String          @id @default(uuid())
  scanId      String
  scan        Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title       String
  description String?
  severity    FindingSeverity @default(MEDIUM)
  status      FindingStatus   @default(OPEN)
  tool        ToolType        
  affectedUrl String?        
  parameter   String?        
  cveId       String?         
  cvssScore   Float?          
  rawRequest  String?
  rawResponse String?
  remediation String?
  owaspUrl    String?
  createdAt   DateTime        @default(now())
}