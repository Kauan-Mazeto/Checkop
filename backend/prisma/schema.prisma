// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Modelo do Banco a seguir: Projeto Checkop

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  DEV
  QA
  PENTESTER
  STUDENT
}

// espec.txt: Free vê o diagnóstico macro; Premium vê PoC, correção, compliance e SAST.
// Sem cobrança real (fora do escopo do TCC, seção 6.3): a troca é demonstrativa.
enum Plan {
  FREE
  PREMIUM
}

enum ToolType {
  ZAP
  NUCLEI
  SUBFINDER
}

// espelha as chaves de src/constants/scan_objectives.js
enum ScanObjective {
  SQL_INJECTION
  XSS
  COMMAND_INJECTION
  PATH_TRAVERSAL
  XXE
  SSTI
  CRLF_INJECTION
  OPEN_REDIRECT
  CSRF
  SSRF
  SECURITY_HEADERS
  COOKIES
  CLICKJACKING
  CORS
  DIRECTORY_LISTING
  EXPOSED_FILES
  ADMIN_PANELS
  INFO_DISCLOSURE
  API_EXPOSURE
  KNOWN_CVE
  SSL_TLS
  DNS_CHECK
  SUBDOMAIN_ENUM
  BASIC_SCAN
  FULL_SCAN
}

enum TargetEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  // interrompida pelo usuário; guarda o que foi verificado até ali
  CANCELED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Como o dono comprovou o controle do alvo (TCC, seção 9)
enum VerificationMethod {
  DNS_TXT
  HTTP_FILE
  META_TAG
}

// DNS prova o domínio inteiro (e subdomínios); arquivo/meta tag provam só o host
enum TargetScope {
  DOMAIN
  HOST
}

enum FindingStatus {
  OPEN
  FALSE_POSITIVE
  FIXED
  IGNORED
}

model User {
  id                       String    @id @default(uuid())
  name                     String
  email                    String    @unique
  password                 String?
  role                     Role      @default(DEV)
  plan                     Plan      @default(FREE)
  // RF-22: e-mail ao terminar cada varredura (o usuário desliga em Conta)
  notifyScanEmail          Boolean   @default(true)
  // idioma dos textos dos achados (título, descrição, correção); código BCP 47
  language                 String    @default("pt-BR")
  // créditos de IA (correção do arquivo inteiro), comprados à parte do plano
  aiCredits                Int       @default(0)
  googleId                 String?   @unique
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  resetPasswordRequestedAt DateTime?
  resetPasswordAttempts    Int       @default(0)
  failedLoginAttempts      Int       @default(0)
  accountLockedUntil       DateTime?
  tokenVersion             Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  scans                    Scan[]
  termsAcceptances         TermsAcceptance[]
  loginAttempts            LoginAttempt[]
  targets                  Target[]
  auditLogs                AuditLog[]
  codeAnalyses             CodeAnalysis[]
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
}

model Scan {
  id                       String            @id @default(uuid())
  targetUrl                String
  objective                ScanObjective     @default(FULL_SCAN)
  environment              TargetEnvironment @default(DEVELOPMENT)
  safeMode                 Boolean           @default(true)
  status                   ScanStatus        @default(PENDING)
  resolvedIps              String?
  suspiciousEnvironment    Boolean           @default(false)
  authorizationConfirmedAt DateTime
  authorizationIp          String?
  // opt-in de varredura ativa em alvo público (art. 154-A CP: autorização expressa)
  activeScanConfirmedAt    DateTime?
  activeScanConfirmationIp String?
  // avisos dos motores em JSON (regra indisponível, ferramenta que falhou...)
  engineWarnings           String?
  targetId                 String?
  target                   Target?           @relation(fields: [targetId], references: [id], onDelete: SetNull)
  startedAt                DateTime?
  finishedAt               DateTime?
  createdAt                DateTime          @default(now())
  userId                   String
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings                 Finding[]

  @@index([suspiciousEnvironment])
  @@index([targetId])
  @@index([userId])
}

model Finding {
  id          String          @id @default(uuid())
  scanId      String
  scan        Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title       String
  description String?
  severity    FindingSeverity @default(MEDIUM)
  status      FindingStatus   @default(OPEN)
  tool        ToolType
  // id da regra que gerou o achado (pluginId do ZAP, template-id do Nuclei);
  // usado para filtrar o resultado pelo objetivo escolhido
  ruleId      String?
  affectedUrl String?        
  parameter   String?        
  // prova de conceito: payload usado e comando para reproduzir (curl)
  attack       String?
  reproduction String?
  cveId       String?         
  cvssScore   Float?          
  // CVSS 3.1: vetor do cálculo e origem (TEMPLATE | CWE | SEVERITY)
  cvssVector  String?
  cvssSource  String?
  // confiança da ferramenta (LOW | MEDIUM | HIGH | CONFIRMED)
  confidence  String?
  rawRequest  String?
  rawResponse String?
  remediation String?
  // como a ferramenta concluiu que é falha (otherinfo do ZAP, matcher do Nuclei)
  detection   String?
  // links de referência da ferramenta, um por linha
  references  String?
  owaspUrl    String?
  createdAt   DateTime        @default(now())
}


// Um registro por versão aceita (histórico): o mais recente diz se o usuário
// está em dia com a versão atual dos Termos (TERMS_OF_USE.version).
model TermsAcceptance {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String   @default("1.0")
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  @@index([userId, acceptedAt])
}

// Alvo cadastrado pelo usuário. Varredura em alvo público só roda com o alvo
// verificado (TCC, objetivo específico 5 e seção 9).
model Target {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostname           String
  scope              TargetScope
  verificationMethod VerificationMethod
  verificationToken  String
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  scans              Scan[]

  @@unique([userId, hostname, scope])
  @@index([userId])
}

// Histórico da análise de código (Premium). Guarda SÓ o resumo do resultado:
// nomes e linguagens dos arquivos, contagens e, por achado, título, severidade,
// categoria, arquivo, linha, regra e ferramentas. NUNCA o código, o trecho
// vulnerável, a correção ou a descrição (Política de Privacidade, item 2.4).
model CodeAnalysis {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  depth           String
  /// JSON: [{ name, language, lines }]
  files           String
  findingsCount   Int
  /// JSON: { CRITICAL, HIGH, MEDIUM, LOW, INFO }
  severityCounts  String
  /// JSON: { SECURITY, LOGIC, SYNTAX, DEPENDENCY, QUALITY }
  categoryCounts  String
  /// JSON: [{ title, severity, category, file, line, ruleId, tools }]
  findings        String
  durationSeconds Float
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// Registro de ações relevantes (RF-16). Guardado por 6 meses mesmo após a
// exclusão da conta (Marco Civil, art. 15; LGPD, art. 16, I): o userId vira null.
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  details      String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Traduções dos textos das regras (ZAP/Nuclei vêm em inglês). Guardadas por
// idioma + hash do original: cada texto é traduzido uma única vez.
model TranslationCache {
  id         String   @id @default(uuid())
  language   String
  sourceHash String
  text       String
  createdAt  DateTime @default(now())

  @@unique([language, sourceHash])
}
