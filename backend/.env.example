# Modelo do backend/.env. Copie para backend/.env e preencha.
# O motor Python (security_engine) lê ESTE MESMO arquivo; não crie outro .env para ele.
# No Docker (docker-compose.yml), os endereços internos (banco, motor, ZAP) são
# definidos pelo próprio compose: aqui basta preencher os segredos e os opcionais.
# Nunca versione o .env real (já está no .gitignore).

# ---------- Obrigatórias (o backend não sobe sem elas) ----------
# Banco SQLite local, criado pelo "npx prisma migrate deploy"
DATABASE_URL="file:./prisma/database.db"
# Segredos: gere cada um com
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
RESET_CODE_SECRET=
# Token compartilhado entre o backend e o motor Python (os dois leem daqui)
ENGINE_TOKEN=
EXPIRES_IN="24h"
PORT=8080
# Endereço do front (o Angular roda em 4200 e encaminha /api para 8080)
CLIENT_URL=http://localhost:4200
# "DEV" em ambiente local: cookie sem Secure (http) e erros de validação detalhados
MODO_DEV="DEV"

# ---------- OWASP ZAP (varredura web) ----------
# Porta 8091: a 8090 costuma estar ocupada no Windows
ZAP_API_URL=http://localhost:8091
# Qualquer texto aleatório; o mesmo valor é passado ao ZAP ao iniciar (o script já faz isso)
ZAP_API_KEY=

# ---------- Login com Google (opcional) ----------
# Client ID do OAuth (não é segredo). Sem ele, o botão do Google não aparece.
GOOGLE_CLIENT_ID=

# ---------- E-mail (opcional: recuperação de senha e aviso de varredura) ----------
# Sem SMTP_HOST, o código de recuperação aparece só no terminal do backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------- Tradução dos achados (opcional) ----------
# Com chave do DeepL (plano free termina em ":fx") a tradução é melhor;
# sem ela, usa o MyMemory (grátis, ~5 mil caracteres/dia; com e-mail, 50 mil).
DEEPL_API_KEY=
MYMEMORY_EMAIL=

# ---------- Correção com IA (opcional) ----------
# Chave da Anthropic. Sem ela, os botões de correção com IA não aparecem.
ANTHROPIC_API_KEY=

# ---------- Ajustes finos (opcional; os padrões já funcionam) ----------
# SECURITY_ENGINE_URL=http://localhost:8010
# APP_URL=http://localhost:4200
# NUCLEI_TEMPLATE_UPDATE_HOURS=24
# ZAP_AJAX_SPIDER_BROWSER=edge-headless
